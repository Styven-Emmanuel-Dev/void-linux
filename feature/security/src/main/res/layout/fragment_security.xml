<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/void_background"
    android:padding="@dimen/space_l">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/security_title"
        android:textColor="@color/void_text"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/security_guard_inactive"
        style="@style/VoidText.Dim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/space_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggleMonitoring"
            style="@style/VoidButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Démarrer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanNow"
            style="@style/VoidButton.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_s"
            android:text="Scanner" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/space_s">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearEvents"
            style="@style/VoidButton.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Effacer les événements" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_m"
        android:background="@color/void_divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/eventsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_m"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_m" />

</LinearLayout>